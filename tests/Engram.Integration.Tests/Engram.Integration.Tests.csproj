<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one MCP-over-HTTP test client, shared with tier 3 rather than copied. -->
    <Compile Include="../Engram.EndToEnd.Tests/HttpMcpClient.cs" Link="HttpMcpClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Engram.Core/Engram.Core.csproj" />
    <ProjectReference Include="../../src/Engram.Cli/Engram.Cli.csproj" />
    <!-- Builds the sidecar so its tests can drive the real binary, without linking
         Roslyn into this process (D1). -->
    <ProjectReference Include="../../src/Engram.Sidecar.Roslyn/engram-roslyn.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
